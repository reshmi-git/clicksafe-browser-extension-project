{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/",                "dest": "/index.html"        },
    { "src": "/features",        "dest": "/features.html"     },
    { "src": "/how-it-works",    "dest": "/how-it-works.html" },
    { "src": "/installation",    "dest": "/installation.html" },
    { "src": "/about",           "dest": "/about.html"        },
    { "src": "/privacy",         "dest": "/privacy.html"      },
    { "handle": "filesystem"                                   },
    { "src": "/(.*)",            "dest": "/index.html"        }
  ]
}